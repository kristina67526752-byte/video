# ---- Work.cam : copiez ce fichier en .env et remplissez les valeurs ----
NODE_ENV=production
PORT=3000
BASE_URL=https://work.cam
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=
# Base de données PostgreSQL
DATABASE_URL=postgres://workcam:MOT_DE_PASSE@db:5432/workcam
POSTGRES_PASSWORD=MOT_DE_PASSE

# Paiement : campay (réel) ou simulation (tests uniquement)
PAYMENT_GATEWAY=campay
# Démo : https://demo.campay.net — Production : https://www.campay.net
CAMPAY_BASE_URL=https://demo.campay.net
CAMPAY_USERNAME=
CAMPAY_PASSWORD=
# (optionnel) jeton permanent si CamPay vous en fournit un
CAMPAY_TOKEN=

# Détection de visage : local (gratuit, défaut) | google | off
FACE_PROVIDER=local
GOOGLE_VISION_API_KEY=
# Nombre d'échecs avant de proposer la validation manuelle
PHOTO_MAX_FAILURES=2

# Vérification du numéro par SMS (on/off) — nécessite un fournisseur SMS (src/services/sms.js)
PHONE_VERIFICATION=off
SMS_PROVIDER=console

# Coordonnées affichées dans le pied de page
SUPPORT_PHONE=
SUPPORT_EMAIL=

# Domaine (sans https://), utilisé par Caddy pour le certificat HTTPS
DOMAIN=work.cam
