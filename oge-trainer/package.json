{
  "name": "oge-english-trainer",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "demo": "vite --mode demo",
    "build:demo": "tsc -b && vite build --mode demo",
    "push-tasks": "node scripts/push-tasks.mjs",
    "check-tasks": "node scripts/push-tasks.mjs --dry-run",
    "check-settings": "node --input-type=module -e \"import('./scripts/settings.mjs').then((m) => m.printDiagnosis())\""
  },
  "dependencies": {
    "@supabase/supabase-js": "2.45.4",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-router-dom": "6.26.2"
  },
  "devDependencies": {
    "@types/react": "18.3.11",
    "@types/react-dom": "18.3.0",
    "@vitejs/plugin-react": "4.3.2",
    "typescript": "5.6.2",
    "vite": "5.4.8"
  }
}
